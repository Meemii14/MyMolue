# MyMolue environment configuration
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///mymolue.db

# Set this to the email that should receive the admin role on registration.
ADMIN_EMAIL=

# Paystack (leave blank until payment integration is enabled)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5000/payment/callback

# Optional realtime deployment settings
SOCKETIO_MESSAGE_QUEUE=
